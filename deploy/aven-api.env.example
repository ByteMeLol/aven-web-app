PORT=8080
# These three values are supplied by docker-compose.yml from the root .env.
# Keep them here only for running the API container outside Compose.
DATABASE_URL=jdbc:postgresql://aven-postgres:5432/aven
DATABASE_USERNAME=aven
DATABASE_PASSWORD=replace-with-the-postgresql-password
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
AVEN_JWT_SECRET=replace-with-a-new-base64-encoded-256-bit-secret
AVEN_FRONTEND_ORIGIN=https://aven.example.com
AVEN_EMAIL=replace-with-smtp-user
AVEN_EMAIL_PASSWORD=replace-with-smtp-password
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret
R2_BUCKET_NAME=aven-assets
R2_ENDPOINT=https://replace-with-r2-endpoint
