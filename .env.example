# Copy this file to .env on the server and replace the placeholders.
AVEN_POSTGRES_DB=aven
AVEN_POSTGRES_USER=aven
AVEN_POSTGRES_PASSWORD=put-your-existing-password-here

# Existing Docker network shared with Nginx Proxy Manager.
AVEN_DOCKER_NETWORK=proxy

# Public API URL embedded into the production frontend build.
VITE_API_BASE_URL=https://api.aven.nelsonhawk.dev
